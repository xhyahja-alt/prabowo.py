print("PROGRAM PEMBELIAN BARANG")

nama = input("Nama barang: ")
harga = int(input("Harga barang: "))
jumlah = int(input("Jumlah barang: "))

total = harga * jumlah

if total >= 100000 and jumlah > 0:
    diskon = total * 0.1
else:
    diskon = 0

bayar = total - diskon

print("\nSTRUK PEMBELIAN")
print("Nama barang:", nama)
print("Harga:", harga)
print("Jumlah:", jumlah)
print("Total:", total)
print("Diskon:", diskon)
print("Total bayar:", bayar)